# Copy this file to ".env" (same folder) and fill in values.
# Secret used by Flask to sign sessions. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string
# Secret used to sign login (JWT) tokens. Any long random string (32+ chars).
JWT_SECRET_KEY=change-me-to-another-long-random-string-32chars
# OPTIONAL. Anthropic API key for real AI (text + image analysis, assistant).
# Leave empty and the app uses a built-in keyword-based AI fallback.
AI_API_KEY=
# OPTIONAL. AI model name.
AI_MODEL=claude-sonnet-4-6
# OPTIONAL. Database URL. Default is SQLite file. PostgreSQL example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/civic
DATABASE_URL=
# Frontend address allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173
